# PKI Vila Aurora — CA própria do projeto (RT-04/RT-05)
# Raiz (offline) -> Intermediária "Issuing" -> certificados de dispositivo/borda/servidor/operador
# Uso: via pki/pki.sh (não chamar diretamente)

[ ca ]
default_ca = issuing

[ issuing ]
dir               = $ENV::PKI_OUT/issuing
database          = $dir/index.txt
serial            = $dir/serial
crlnumber         = $dir/crlnumber
new_certs_dir     = $dir/newcerts
certificate       = $dir/issuing.crt
private_key       = $dir/issuing.key
crl               = $dir/issuing.crl
default_md        = sha256
default_days      = 365
default_crl_days  = 7
policy            = policy_any
unique_subject    = yes
copy_extensions   = copy
email_in_dn       = no

[ root ]
dir               = $ENV::PKI_OUT/root
database          = $dir/index.txt
serial            = $dir/serial
crlnumber         = $dir/crlnumber
new_certs_dir     = $dir/newcerts
certificate       = $dir/root.crt
private_key       = $dir/root.key
default_md        = sha256
default_days      = 1825
default_crl_days  = 30
policy            = policy_any
unique_subject    = yes
copy_extensions   = none

[ policy_any ]
commonName              = supplied
organizationName        = optional
organizationalUnitName  = optional

[ req ]
distinguished_name = dn
prompt             = no
[ dn ]
CN = placeholder

# ---------- extensões ----------
[ v3_root ]
basicConstraints       = critical, CA:true
keyUsage               = critical, keyCertSign, cRLSign
subjectKeyIdentifier   = hash

[ v3_issuing ]
basicConstraints       = critical, CA:true, pathlen:0
keyUsage               = critical, keyCertSign, cRLSign
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always

# Dispositivo IoT: só autenticação de cliente
[ v3_device ]
basicConstraints       = critical, CA:false
keyUsage               = critical, digitalSignature
extendedKeyUsage       = clientAuth
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid
crlDistributionPoints  = URI:http://pki.vilaaurora.test/issuing.crl

# Nó de borda: cliente (para a nuvem) e servidor (broker local)
[ v3_edge ]
basicConstraints       = critical, CA:false
keyUsage               = critical, digitalSignature
extendedKeyUsage       = clientAuth, serverAuth
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid
subjectAltName         = $ENV::PKI_SAN
crlDistributionPoints  = URI:http://pki.vilaaurora.test/issuing.crl

# Serviço servidor (ingest, painel, broker)
[ v3_server ]
basicConstraints       = critical, CA:false
keyUsage               = critical, digitalSignature
extendedKeyUsage       = serverAuth
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid
subjectAltName         = $ENV::PKI_SAN
crlDistributionPoints  = URI:http://pki.vilaaurora.test/issuing.crl

# Serviço cliente interno (soar, painel -> ingest)
[ v3_client ]
basicConstraints       = critical, CA:false
keyUsage               = critical, digitalSignature
extendedKeyUsage       = clientAuth
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid
crlDistributionPoints  = URI:http://pki.vilaaurora.test/issuing.crl
